# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The custom domain or hosted URL for Fetecart
APP_URL="https://www.fetecart.com"

# CJ Dropshipping Open API Key (Developers v2.0)
# Example format: CJ5539327@api@e3493bd733e04651a7e8946da35cb431
CJDROPSHIPPING_API_KEY=""

# Stripe Payment Gateway Keys for fetecart.com
# Publishable key used in frontend checkout:
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_51UGga1DH2aCzSlUFgVbSyLWYp4Wv5U2H1NzXP0F0eWX27dgfGE9txxuq5WzNzS4RtHgm85z5ecQWOT9N3E2Huh5D002rxhgqTA"
STRIPE_PUBLISHABLE_KEY="pk_live_51UGga1DH2aCzSlUFgVbSyLWYp4Wv5U2H1NzXP0F0eWX27dgfGE9txxuq5WzNzS4RtHgm85z5ecQWOT9N3E2Huh5D002rxhgqTA"
# Stripe Secret Key (server-side only, never expose in client code):
STRIPE_SECRET_KEY=""

# Stripe Webhook Signing Secret (e.g. whsec_... for verifying incoming webhook signatures)
STRIPE_WEBHOOK_SECRET=""

# Automated Server-Side Email Sender Configuration
# Inquiries sent by customers will route to CONTACT_EMAIL (default: contact@fetecart.com)
CONTACT_EMAIL="contact@fetecart.com"
# Outgoing email sender identity
SMTP_FROM="Fetecart Concierge <contact@fetecart.com>"

# Optional: Real SMTP relay credentials (e.g. Resend, SendGrid, Amazon SES, Mailgun, Google Workspace SMTP)
# If left blank, inquiries are safely processed, logged, and tracked in the Admin Portal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
